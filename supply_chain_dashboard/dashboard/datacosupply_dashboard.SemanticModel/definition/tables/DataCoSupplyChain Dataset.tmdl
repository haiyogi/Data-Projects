table 'DataCoSupplyChain Dataset'
	lineageTag: 512f1f8c-3cc5-4a4b-81a9-85d074601f60

	measure 'Total Orders' =
			
			DISTINCTCOUNT('DataCoSupplyChain Dataset'[Order Id])
		formatString: 0
		lineageTag: 7480f9c1-f454-451b-8513-95546f166776

	measure 'Non-Cancelled Orders' =
			
			CALCULATE(
			    [Total Orders],
			    KEEPFILTERS(
			        'DataCoSupplyChain Dataset'[Delivery Status] <> "Shipping canceled"
			    )
			)
		formatString: 0
		lineageTag: 91d951cf-31e6-426e-ac6f-54e284cc38b0

	measure 'Late Orders' =
			
			CALCULATE(
			    [Total Orders],
			    KEEPFILTERS(
			        'DataCoSupplyChain Dataset'[Delivery Status] = "Late delivery"
			    )
			)
		formatString: 0
		lineageTag: fdce7bdc-d5d1-476f-ab83-dc5eb05c31e1

	measure 'Late Delivery Rate' =
			
			DIVIDE(
			    [Late Orders],
			    [Non-Cancelled Orders]
			)
		lineageTag: b60a893a-cad3-48dc-8f2b-24b7164e3cf1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Actual Days' =
			
			CALCULATE(
			    AVERAGEX(
			        VALUES('DataCoSupplyChain Dataset'[Order Id]),
			        CALCULATE(
			            MAX('DataCoSupplyChain Dataset'[Days for shipping (real)])
			        )
			    ),
			    KEEPFILTERS(
			        'DataCoSupplyChain Dataset'[Delivery Status] <> "Shipping canceled"
			    )
			)
		lineageTag: 6e5735e2-d08a-4096-9817-7a0df2303dd6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Average Scheduled Days' =
			
			CALCULATE(
			    AVERAGEX(
			        VALUES('DataCoSupplyChain Dataset'[Order Id]),
			        CALCULATE(
			            MAX('DataCoSupplyChain Dataset'[Days for shipment (scheduled)])
			        )
			    ),
			    KEEPFILTERS(
			        'DataCoSupplyChain Dataset'[Delivery Status] <> "Shipping canceled"
			    )
			)
		lineageTag: e535dd33-8b97-4fdd-baaa-7b5692b581a6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Cancelled Orders' =
			
			CALCULATE(
			    [Total Orders],
			    KEEPFILTERS(
			        'DataCoSupplyChain Dataset'[Delivery Status] = "Shipping canceled"
			    )
			)
		formatString: 0
		lineageTag: e83d16a7-fc5a-4b1b-8fdd-b7f6fddbdaa6

	measure 'Net Sales' =
			
			SUM('DataCoSupplyChain Dataset'[Order Item Total])
		lineageTag: 1101a631-3993-497b-bcae-7b9b6860c0bd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Recorded Profit' =
			
			SUM('DataCoSupplyChain Dataset'[Order Profit Per Order])
		lineageTag: c72574b8-0285-4519-98a3-4b22de3d6113

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Profit Margin' =
			
			DIVIDE(
			    [Total Recorded Profit],
			    [Net Sales]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: eba103b2-8f85-44d6-9a2e-b90bfa8044e2

	measure 'Average Order Value' =
			
			DIVIDE(
			    [Net Sales],
			    [Total Orders]
			)
		lineageTag: f410fed6-3acd-4561-bc4e-454ffcd66e60

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Recorded Loss Amount' =
			
			VAR LossTotal =
			    CALCULATE(
			        SUM('DataCoSupplyChain Dataset'[Order Profit Per Order]),
			        KEEPFILTERS(
			            'DataCoSupplyChain Dataset'[Order Profit Per Order] < 0
			        )
			    )
			RETURN
			    -COALESCE(LossTotal, 0)
		lineageTag: 89cae87d-c56a-4ae6-bac1-138b20b60325

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Loss-Making Items' =
			
			CALCULATE(
			    COUNTROWS('DataCoSupplyChain Dataset'),
			    KEEPFILTERS(
			        'DataCoSupplyChain Dataset'[Order Profit Per Order] < 0
			    )
			)
		formatString: 0
		lineageTag: fc6bac68-3278-4874-a3db-a545649c63fc

	measure 'Markets Served' =
			
			DISTINCTCOUNT('DataCoSupplyChain Dataset'[Market])
		formatString: 0
		lineageTag: a1c3c072-8ba1-40ad-af76-9c05c68269c9

	measure 'Regions Served' =
			
			DISTINCTCOUNT('DataCoSupplyChain Dataset'[Order Region])
		formatString: 0
		lineageTag: 8341e33f-98cd-404b-b680-e34b385f80df

	measure 'Sales Associated with Late Orders' =
			
			CALCULATE(
			    [Net Sales],
			    KEEPFILTERS(
			        'DataCoSupplyChain Dataset'[Delivery Status] = "Late delivery"
			    )
			)
		lineageTag: 07c9d382-cd3a-4782-bec2-fa0d17c757e8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

