	column 'Delivery Difference Days' =
			
			'DataCoSupplyChain Dataset'[Days for shipping (real)]
			    - 'DataCoSupplyChain Dataset'[Days for shipment (scheduled)]]
		formatString: 0
		lineageTag: 1c443c81-d503-4683-816a-09f3fcb60b92
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Delivery Timing' =
			
			VAR DaysDifference = 'DataCoSupplyChain Dataset'[Delivery Difference Days]
			RETURN
			    SWITCH(
			        TRUE(),
			        'DataCoSupplyChain Dataset'[Delivery Status] = "Shipping canceled", "Cancelled",
			        DaysDifference < 0,
			            FORMAT(ABS(DaysDifference), "0") & " day(s) early",
			        DaysDifference = 0, "On time",
			        FORMAT(DaysDifference, "0") & " day(s) late"
			    )
		lineageTag: fb7a2204-ea5f-4ff2-a711-38b55979a352
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Delivery Timing Sort' =
			
			IF(
			    'DataCoSupplyChain Dataset'[Delivery Status] = "Shipping canceled",
			    99,
			    'DataCoSupplyChain Dataset'[Delivery Difference Days]
			)
		formatString: 0
		lineageTag: 3b99e9cc-c644-4136-8ae5-e51188ad53ee
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Sales Month' =
			
			FORMAT(
			    'DataCoSupplyChain Dataset'[order date (DateOrders)],
			    "MMM yyyy"
			)
		lineageTag: 7be420c1-eb31-43cb-86c0-d48a953c49d8
		summarizeBy: none
		sortByColumn: 'Sales Month Order'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Sales Month Sort' =
			
